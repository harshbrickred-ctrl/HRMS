{
  "version": 2,
  "buildCommand": "npx prisma generate && npx nest build",
  "installCommand": "npm install --legacy-peer-deps",
  "builds": [
    {
      "src": "dist/main.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["prisma/**", "node_modules/.prisma/**", "node_modules/@prisma/client/**"]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "dist/main.js" }]
}
