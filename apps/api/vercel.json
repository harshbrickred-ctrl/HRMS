{
  "buildCommand": "npm install --no-save typescript && npx prisma generate && npx nest build",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/.prisma/**"
    }
  }
}
