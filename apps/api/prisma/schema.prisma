generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model Tenant {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  users       User[]
  roles       Role[]
  audits      AuditEvent[]
  departments Department[]
  locations   Location[]
  teams       Team[]
  employees   Employee[]
  shifts               Shift[]
  shiftAssignments     ShiftAssignment[]
  holidays             Holiday[]
  attendancePolicy     AttendancePolicy?
  attendanceDevices    AttendanceDevice[]
  attendancePunches    AttendancePunch[]
  attendanceDays       AttendanceDay[]
  attendanceCorrections AttendanceCorrection[]
  attendancePeriods    AttendancePeriod[]
  deviceOperationLogs  DeviceOperationLog[]
  leaveRequests        LeaveRequest[]
  notifications        Notification[]
  helpdeskTickets      HelpdeskTicket[]
  payslips             Payslip[]
  salaryStructures     SalaryStructure[]
  salaryLines          SalaryLine[]
  payrollMonths        PayrollMonth[]
  bankConnection       BankConnection?
  transferBatches      SalaryTransferBatch[]
  bankApiLogs          BankApiLog[]
  assets               Asset[]
  assetAssignments     AssetAssignment[]
  assetTickets         AssetTicket[]
  assetCategories      AssetCategory[]
  assetStatusHistory   AssetStatusHistory[]
  assetRequests        AssetRequest[]
  assetMaintenance     AssetMaintenance[]
}

model User {
  id            String             @id @default(cuid())
  tenantId      String
  email         String
  passwordHash  String
  status        UserStatus         @default(ACTIVE)
  mfaEnabled    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  roles         UserRole[]
  refreshTokens RefreshToken[]
  auditEvents   AuditEvent[]       @relation("AuditActor")
  passwordResets PasswordResetOtp[]
  employee       Employee?
  notifications  Notification[]
  assetCategoriesCreated AssetCategory[] @relation("AssetCategoryCreatedBy")
  assetCategoriesUpdated AssetCategory[] @relation("AssetCategoryUpdatedBy")
  assetsCreated  Asset[]            @relation("AssetCreatedBy")
  assetsUpdated  Asset[]            @relation("AssetUpdatedBy")
  assetsIssued   AssetAssignment[]  @relation("AssetIssuedBy")
  assetsAcknowledged AssetAssignment[] @relation("AssetAckBy")
  assetsReceived AssetAssignment[]  @relation("AssetReturnedBy")
  assetHandovers AssetAssignment[]  @relation("AssetHandoverAckBy")
  assetStatusChanges AssetStatusHistory[]
  assetFilesUploaded AssetAssignmentFile[]
  assetTicketFilesUploaded AssetTicketFile[]
  assetRequestsCreated AssetRequest[] @relation("AssetRequestCreatedBy")
  assetRequestsFulfilled AssetRequest[] @relation("AssetRequestFulfilledBy")
  assetRequestDecisions AssetRequestDecision[]
  assetMaintenanceCreated AssetMaintenance[] @relation("AssetMaintenanceCreatedBy")
  assetMaintenanceUpdated AssetMaintenance[] @relation("AssetMaintenanceUpdatedBy")

  @@unique([tenantId, email])
  @@index([email])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String
  code        String
  name        String
  createdAt   DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, code])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

model PasswordResetOtp {
  id                    String    @id @default(cuid())
  userId                String
  otpHash               String
  expiresAt             DateTime
  attemptCount          Int       @default(0)
  consumedAt            DateTime?
  resetSessionHash      String?
  resetSessionExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resetSessionHash])
}

model Department {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  /// Approves asset requests after the reporting manager.
  headId    String?
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  head      Employee?  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  teams     Team[]
  employees Employee[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Location {
  id        String     @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]
  devices   AttendanceDevice[]
  holidays  Holiday[]
  assets    Asset[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Team {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  departmentId String
  managerId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager      Employee?  @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members      Employee[] @relation("TeamMembers")

  @@unique([tenantId, departmentId, name])
  @@index([tenantId])
  @@index([managerId])
}

model Employee {
  id           String             @id @default(cuid())
  tenantId     String
  userId       String             @unique
  employeeCode String
  firstName    String
  lastName     String
  designation       String             @default("")
  photo             String             @default("")
  bankName          String             @default("")
  ifscCode          String             @default("")
  bankAccountNumber String             @default("")
  departmentId String?
  locationId   String?
  teamId       String?
  managerId    String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  location     Location?          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  team         Team?              @relation("TeamMembers", fields: [teamId], references: [id], onDelete: Restrict)
  manager      Employee?          @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      Employee[]         @relation("EmployeeManager")
  managedTeams Team[]             @relation("TeamManager")
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]  @relation("LeaveRequester")
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")
  documents    EmployeeDocument[]
  shiftAssignments ShiftAssignment[]
  attendanceDays AttendanceDay[]
  punches      AttendancePunch[]
  corrections  AttendanceCorrection[]
  enrollments  DeviceEnrollment[]
  helpdeskTickets HelpdeskTicket[]
  payslips     Payslip[]
  salaryStructure SalaryStructure?
  salaryLines  SalaryLine[]
  assetAssignments AssetAssignment[]
  assetTickets AssetTicket[]
  headOfDepartments Department[] @relation("DepartmentHead")
  assetRequests AssetRequest[] @relation("AssetRequestFor")
  assetRequestsToApprove AssetRequest[] @relation("AssetRequestManager")
  assetRequestsToApproveAsHead AssetRequest[] @relation("AssetRequestHead")

  @@unique([tenantId, employeeCode])
  @@index([tenantId])
  @@index([managerId])
}

model LeaveBalance {
  id         String   @id @default(cuid())
  employeeId String
  code       String
  type       String
  entitled   Float    @default(0)
  used       Float    @default(0)
  pending    Float    @default(0)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, code])
}

enum LeaveRequestStatus {
  Pending
  Approved
  Rejected
  Withdrawn
}

model LeaveRequest {
  id                 String             @id @default(cuid())
  tenantId           String
  employeeId         String
  code               String
  type               String
  fromDate           DateTime           @db.Date
  toDate             DateTime           @db.Date
  days               Float
  halfDayStart       Boolean            @default(false)
  halfDayEnd         Boolean            @default(false)
  fromHalfStart      Boolean            @default(false)
  fromHalfEnd        Boolean            @default(false)
  toHalfStart        Boolean            @default(false)
  toHalfEnd          Boolean            @default(false)
  reason             String
  status             LeaveRequestStatus @default(Pending)
  approverEmployeeId String?
  decisionNote       String             @default("")
  decidedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee           Employee           @relation("LeaveRequester", fields: [employeeId], references: [id], onDelete: Cascade)
  approver           Employee?          @relation("LeaveApprover", fields: [approverEmployeeId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, status])
  @@index([tenantId, approverEmployeeId, status])
  @@index([tenantId, fromDate, toDate])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  title     String
  body      String    @default("")
  href      String    @default("")
  kind      String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
  @@index([userId, readAt])
}

enum HelpdeskTicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model HelpdeskTicket {
  id         String               @id @default(cuid())
  tenantId   String
  employeeId String
  category   String
  subject    String
  body       String
  status     HelpdeskTicketStatus @default(Open)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  comments   HelpdeskComment[]

  @@index([tenantId, employeeId, status])
  @@index([tenantId, status])
}

model HelpdeskComment {
  id        String         @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime       @default(now())
  ticket    HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Payslip {
  id          String   @id @default(cuid())
  tenantId    String
  employeeId  String
  month       String
  label       String
  fileName    String
  storagePath String
  uploadedAt  DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, month])
  @@index([tenantId, employeeId])
}

model SalaryStructure {
  id               String   @id @default(cuid())
  tenantId         String
  employeeId       String   @unique
  monthlyGross     Int
  basic            Int
  hra              Int
  da               Int      @default(0)
  otherAllowances  Int      @default(0)
  statutoryBonus   Int      @default(0)
  dailyAllowance   Int      @default(0)
  gratuityMonthly  Int      @default(0)
  leaveEncashment  Int      @default(0)
  pfOnActual       Boolean  @default(false)
  taxRegime        String   @default("new")
  ptMonthly        Int      @default(0)
  annualDeductions Int      @default(0)
  ytdTaxable       Int      @default(0)
  ytdTds           Int      @default(0)
  ytdPt            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SalaryLine {
  id              String   @id @default(cuid())
  tenantId        String
  employeeId      String
  month           String
  monthDays       Int
  paidDays        Int
  lopDays         Int      @default(0)
  basic           Int
  hra             Int
  da              Int
  special         Int
  otherAllowances Int
  bonus           Int      @default(0)
  statutoryBonus  Int      @default(0)
  dailyAllowance  Int      @default(0)
  overtime        Int      @default(0)
  incentive       Int      @default(0)
  arrears         Int      @default(0)
  leaveEncashment Int      @default(0)
  fixedGross      Int
  gross           Int
  pfWages         Int
  eePf            Int
  erPf            Int
  erEps           Int
  erEpf           Int
  erEdli          Int
  erAdmin         Int
  eeEsi           Int
  erEsi           Int
  pt              Int
  tds             Int
  tdsRegular      Int
  tdsExtra        Int
  loanRecovery    Int      @default(0)
  advanceRecovery Int      @default(0)
  otherDeduction  Int      @default(0)
  netPay          Int
  gratuityAccrual Int
  employerCost    Int
  status             String   @default("draft")
  submittedToFinance Boolean @default(false)
  payoutGenerated    Boolean @default(false)
  paymentStatus      String  @default("pending")
  utr                String  @default("")
  warning            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeId, month])
  @@index([tenantId, month])
}

model PayrollMonth {
  id         String    @id @default(cuid())
  tenantId   String
  month      String
  approved   Boolean   @default(false)
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
}

model BankConnection {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  bankCode            String
  corporateId         String
  corporateUserCipher String
  accountCipher       String
  accountLast4        String
  mode                String   @default("mock")
  status              String   @default("mock_connected")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SalaryTransferBatch {
  id              String                      @id @default(cuid())
  tenantId        String
  month           String
  reference       String
  status          String                      @default("pending")
  createdById     String
  initiatedAt     DateTime?
  authorisedById  String?
  authorisedAt    DateTime?
  providerRef     String                      @default("")
  otpHash         String                      @default("")
  otpExpiresAt    DateTime?
  willPayCount    Int
  skippedCount    Int
  totalAmount     Int
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions    SalaryTransferTransaction[]

  @@unique([tenantId, reference])
  @@index([tenantId, month])
}

model SalaryTransferTransaction {
  id             String              @id @default(cuid())
  tenantId       String
  batchId        String
  employeeId     String
  month          String
  amount         Int
  status         String
  skipReason       String              @default("")
  utr              String              @default("")
  providerPayoutId String              @default("")
  idempotencyKey   String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  batch          SalaryTransferBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([tenantId, month])
}

model BankApiLog {
  id        String   @id @default(cuid())
  tenantId  String
  batchId   String   @default("")
  action    String
  summary   String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

model EmployeeDocument {
  id          String   @id @default(cuid())
  employeeId  String
  fileName    String
  category    String
  storagePath String
  uploadedAt  DateTime @default(now())
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

enum AttendanceStatus {
  present
  absent
  half_day
  holiday
  leave
  weekend
  missing_punch
}

enum PunchSource {
  web
  device
  correction
  hr
}

enum PunchDirection {
  IN
  OUT
  BREAK_OUT
  BREAK_IN
  OT_IN
  OT_OUT
}

enum DeviceDirectionMode {
  device
  inferred
}

enum CorrectionStatus {
  Pending
  Approved
  Rejected
}

enum AttendancePeriodStatus {
  open
  locked
}

enum EnrollmentStatus {
  pending
  active
  revoked
}

enum DeviceCommandState {
  queued
  sent
  succeeded
  failed
}

model Shift {
  id            String            @id @default(cuid())
  tenantId      String
  code          String
  name          String
  startTime     String
  endTime       String
  breakMinutes  Int               @default(0)
  overnight     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments   ShiftAssignment[]
  days          AttendanceDay[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  tenantId      String
  employeeId    String
  shiftId       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId, effectiveFrom])
  @@index([shiftId])
}

model Holiday {
  id          String    @id @default(cuid())
  tenantId    String
  locationId  String?
  holidayDate DateTime  @db.Date
  name        String
  createdAt   DateTime  @default(now())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location    Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([tenantId, holidayDate])
  @@index([locationId])
}

model AttendancePolicy {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  timeZone                String   @default("Asia/Kolkata")
  graceMinutes            Int      @default(10)
  halfDayMaxMinutes       Int      @default(300)
  duplicateWindowMinutes  Int      @default(5)
  webPunchEnabled         Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AttendanceDevice {
  id             String               @id @default(cuid())
  tenantId       String
  locationId     String?
  serial         String
  name           String
  model          String               @default("")
  firmware       String               @default("")
  timeZone       String               @default("Asia/Kolkata")
  commKeyHash    String?
  lastStamp      String               @default("0")
  lastSeenAt     DateTime?
  directionMode  DeviceDirectionMode  @default(inferred)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location       Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  enrollments    DeviceEnrollment[]
  commands       DeviceCommand[]
  punches        AttendancePunch[]
  operationLogs  DeviceOperationLog[]

  @@unique([tenantId, serial])
  @@index([serial])
}

model DeviceEnrollment {
  id         String           @id @default(cuid())
  deviceId   String
  employeeId String
  pin        String
  status     EnrollmentStatus @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  device     AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([deviceId, pin])
  @@index([employeeId])
}

model DeviceCommand {
  id           Int                @id @default(autoincrement())
  deviceId     String
  body         String
  state        DeviceCommandState @default(queued)
  returnCode   Int?
  enrollmentId String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  device       AttendanceDevice   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, state])
}

model DeviceOperationLog {
  id        String           @id @default(cuid())
  tenantId  String
  deviceId  String?
  kind      String
  raw       String
  createdAt DateTime         @default(now())
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  device    AttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
}

model AttendancePunch {
  id             String          @id @default(cuid())
  tenantId       String
  employeeId     String?
  deviceId       String?
  serial         String          @default("")
  pin            String
  rawTimestamp   String
  punchedAt      DateTime
  businessDate   DateTime        @db.Date
  statusCode     Int
  verifyMode     Int             @default(0)
  direction      PunchDirection?
  source         PunchSource
  workCode       String          @default("")
  idempotencyKey String          @unique
  rawLine        String          @default("")
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee       Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  device         AttendanceDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, businessDate])
  @@index([tenantId, businessDate])
  @@index([deviceId])
}

model AttendanceDay {
  id              String            @id @default(cuid())
  tenantId        String
  employeeId      String
  attendanceDate  DateTime          @db.Date
  shiftId         String?
  status          AttendanceStatus
  firstInAt       DateTime?
  lastOutAt       DateTime?
  workMinutes     Int?
  lateMinutes     Int?
  earlyMinutes    Int?
  breakMinutes    Int?
  missingPunch    Boolean           @default(false)
  overrideStatus  AttendanceStatus?
  note            String            @default("")
  locked          Boolean           @default(false)
  rebuiltAt       DateTime          @default(now())
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shift           Shift?            @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeId, attendanceDate])
  @@index([tenantId, attendanceDate])
}

model AttendanceCorrection {
  id                 String           @id @default(cuid())
  tenantId           String
  employeeId         String
  attendanceDate     DateTime         @db.Date
  requestedStatus    AttendanceStatus
  proposedCheckIn    String?
  proposedCheckOut   String?
  reason             String
  status             CorrectionStatus @default(Pending)
  approverEmployeeId String?
  decisionNote       String           @default("")
  beforeSnapshot     Json?
  afterSnapshot      Json?
  decidedAt          DateTime?
  createdAt          DateTime         @default(now())
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee           Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId, attendanceDate])
  @@index([tenantId, status])
}

model AttendancePeriod {
  id         String                 @id @default(cuid())
  tenantId   String
  year       Int
  month      Int
  status     AttendancePeriodStatus @default(open)
  lockedById String?
  lockedAt   DateTime?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
}

enum AssetStatus {
  in_stock
  allocated
  under_maintenance
  lost
  retired
  disposed
  written_off
}

enum AssetAckStatus {
  pending
  acknowledged
  not_recorded
}

enum AssetReturnCondition {
  good
  damaged
  requires_repair
  missing_components
}

enum AssetAssignmentEnd {
  returned
  transferred
  lost
}

enum AssetRequestStatus {
  pending_manager
  pending_head
  approved
  rejected
  fulfilled
  cancelled
}

enum AssetMaintenanceStatus {
  open
  completed
}

enum AssetRepairOutcome {
  repaired
  beyond_repair
}

enum AssetTicketType {
  Issue
  Query
  Request
  Loss
}

enum AssetTicketPriority {
  low
  medium
  high
}

enum AssetTicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

/// Configurable per tenant. `fields` holds the category's custom field definitions.
model AssetCategory {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  tagPrefix     String
  nextTagNumber Int      @default(1)
  fields        Json     @default("[]")
  /// Straight-line depreciation period used for book value.
  usefulLifeMonths Int   @default(48)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  updatedById   String?
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation("AssetCategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?    @relation("AssetCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assets        Asset[]
  requests      AssetRequest[]

  @@unique([tenantId, code])
  @@unique([tenantId, tagPrefix])
}

model Asset {
  id             String            @id @default(cuid())
  tenantId       String
  assetTag       String
  categoryId     String
  name           String
  make           String            @default("")
  model          String            @default("")
  serialNo       String?
  status         AssetStatus       @default(in_stock)
  purchasedOn    DateTime?
  vendor         String            @default("")
  /// Who owns the device, e.g. the company, a client, or a rental vendor.
  owner          String            @default("")
  cost           Decimal?          @db.Decimal(12, 2)
  warrantyExpiry DateTime?         @db.Date
  locationId     String?
  photoPath      String            @default("")
  description    String            @default("")
  /// Condition as written in an imported sheet. Issue and return conditions take over once recorded.
  condition      String            @default("")
  customFields   Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdById    String?
  updatedById    String?
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       AssetCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location       Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy      User?             @relation("AssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?             @relation("AssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  assignments    AssetAssignment[]
  tickets        AssetTicket[]
  statusHistory  AssetStatusHistory[]
  maintenance    AssetMaintenance[]

  @@unique([tenantId, assetTag])
  @@unique([tenantId, serialNo])
  @@index([tenantId, status])
  @@index([tenantId, categoryId])
  @@index([tenantId, locationId])
}

model AssetAssignment {
  id             String    @id @default(cuid())
  tenantId       String
  assetId        String
  employeeId     String
  assignedOn     DateTime  @default(now())
  expectedReturnOn DateTime? @db.Date
  returnedOn     DateTime?
  conditionNotes String    @default("")
  issueCondition String    @default("")
  accessories    String    @default("")
  /// Project or work the device is issued for, and the holder's contact details at issue.
  project        String    @default("")
  contactMobile  String    @default("")
  employmentType String    @default("")
  issuedById     String?
  ackStatus      AssetAckStatus @default(pending)
  /// The employee is asked to accept by this day.
  ackDueOn       DateTime? @db.Date
  ackAt          DateTime?
  ackById        String?
  ackMethod      String    @default("")
  returnCondition AssetReturnCondition?
  damageNotes    String    @default("")
  inspectionNotes String   @default("")
  returnedById   String?
  endReason      AssetAssignmentEnd?
  transferredFromId String? @unique
  transferReason String    @default("")
  handoverAckStatus AssetAckStatus?
  handoverAckAt  DateTime?
  handoverAckById String?
  handoverAckMethod String @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  issuedBy       User?     @relation("AssetIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  ackBy          User?     @relation("AssetAckBy", fields: [ackById], references: [id], onDelete: SetNull)
  returnedBy     User?     @relation("AssetReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)
  handoverAckBy  User?     @relation("AssetHandoverAckBy", fields: [handoverAckById], references: [id], onDelete: SetNull)
  transferredFrom AssetAssignment? @relation("AssetTransfer", fields: [transferredFromId], references: [id], onDelete: Restrict)
  transferredTo  AssetAssignment? @relation("AssetTransfer")
  files          AssetAssignmentFile[]
  request        AssetRequest?

  @@index([tenantId, employeeId, returnedOn])
  @@index([assetId, returnedOn])
}

/// Every status an asset has moved through: permanent, never edited.
model AssetStatusHistory {
  id          String      @id @default(cuid())
  tenantId    String
  assetId     String
  fromStatus  AssetStatus
  toStatus    AssetStatus
  reason      String
  /// What caused the change: allocation | return | status | maintenance
  source      String      @default("status")
  changedById String?
  changedAt   DateTime    @default(now())
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset       Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  changedBy   User?       @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([assetId, changedAt])
  @@index([tenantId, changedAt])
}

/// Signed acknowledgement forms and return photos. `kind`: signed_ack | handover_ack | return_photo
model AssetAssignmentFile {
  id           String          @id @default(cuid())
  assignmentId String
  kind         String
  fileName     String
  storagePath  String
  uploadedById String?
  uploadedAt   DateTime        @default(now())
  assignment   AssetAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  uploadedBy   User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([assignmentId])
}

model AssetTicket {
  id         String            @id @default(cuid())
  /// Shown to people as the report reference, e.g. AT-000123.
  number     Int               @unique @default(autoincrement())
  tenantId   String
  employeeId String
  assetId    String?
  type       AssetTicketType
  /// Fault category or lost/stolen for reports; a category code for requests.
  category   String            @default("")
  priority   AssetTicketPriority @default(medium)
  lostOn     DateTime?         @db.Date
  lostLocation String          @default("")
  subject    String
  body       String
  status     AssetTicketStatus @default(Open)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  asset      Asset?            @relation(fields: [assetId], references: [id], onDelete: SetNull)
  comments   AssetTicketComment[]
  files      AssetTicketFile[]
  maintenance AssetMaintenance[]

  @@index([tenantId, employeeId, status])
  @@index([tenantId, status])
}

/// Photos and documents attached to an employee's report.
model AssetTicketFile {
  id           String      @id @default(cuid())
  ticketId     String
  fileName     String
  storagePath  String
  uploadedById String?
  uploadedAt   DateTime    @default(now())
  ticket       AssetTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

model AssetTicketComment {
  id        String      @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime    @default(now())
  ticket    AssetTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

/// Employee request: manager approves, then the department head, then an asset admin issues.
model AssetRequest {
  id                String             @id @default(cuid())
  /// Shown to people as the request reference, e.g. AR-000123.
  number            Int                @unique @default(autoincrement())
  tenantId          String
  employeeId        String
  categoryId        String
  reason            String
  status            AssetRequestStatus
  managerApproverId String?
  headApproverId    String?
  fulfilledById     String?
  fulfilledAt       DateTime?
  assignmentId      String?            @unique
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee          Employee           @relation("AssetRequestFor", fields: [employeeId], references: [id], onDelete: Restrict)
  category          AssetCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  managerApprover   Employee?          @relation("AssetRequestManager", fields: [managerApproverId], references: [id], onDelete: SetNull)
  headApprover      Employee?          @relation("AssetRequestHead", fields: [headApproverId], references: [id], onDelete: SetNull)
  fulfilledBy       User?              @relation("AssetRequestFulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)
  createdBy         User?              @relation("AssetRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignment        AssetAssignment?   @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  decisions         AssetRequestDecision[]

  @@index([tenantId, status])
  @@index([managerApproverId, status])
  @@index([headApproverId, status])
  @@index([employeeId])
}

/// One row per approval step decided: permanent, never edited.
model AssetRequestDecision {
  id          String       @id @default(cuid())
  requestId   String
  /// manager | head | admin
  step        String
  approved    Boolean
  note        String       @default("")
  decidedById String?
  decidedAt   DateTime     @default(now())
  request     AssetRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  decidedBy   User?        @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([requestId])
}

/// Repair record. A partial unique index allows one open record per asset.
model AssetMaintenance {
  id            String                 @id @default(cuid())
  tenantId      String
  assetId       String
  ticketId      String?
  issue         String
  vendor        String                 @default("")
  vendorContact String                 @default("")
  startedOn     DateTime               @db.Date
  expectedOn    DateTime?              @db.Date
  completedOn   DateTime?              @db.Date
  cost          Decimal?               @db.Decimal(12, 2)
  outcome       AssetRepairOutcome?
  outcomeNotes  String                 @default("")
  status        AssetMaintenanceStatus @default(open)
  /// Where an open repair is: with_vendor | testing | ready
  stage         String                 @default("with_vendor")
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  createdById   String?
  updatedById   String?
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  ticket        AssetTicket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdBy     User?                  @relation("AssetMaintenanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?                  @relation("AssetMaintenanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([assetId])
}

// ─── Alumni portal ───────────────────────────────────────────────────────────
// Alumni tables keep tenantId and employeeId as plain indexed columns (no Prisma
// relations to Tenant/Employee/User) so the existing models stay unchanged.
// Tenant scoping and ownership are enforced in apps/api/src/alumni.

enum AlumniEligibility {
  eligible
  not_eligible
  do_not_contact
}

enum AlumniAccountStatus {
  active
  /// HR set Do Not Contact; a new invitation is needed to come back.
  revoked
  /// The alumnus withdrew data-processing consent.
  withdrawn
}

enum AlumniConsentType {
  terms
  data_processing
  communications
  directory
}

enum AlumniOtpPurpose {
  password_reset
  email_change
}

enum AlumniDocumentType {
  experience_letter
  relieving_letter
  payslip
  form16
  fnf_statement
  pf_details
  other
}

enum AlumniDocumentRequestStatus {
  submitted
  under_review
  approved
  rejected
  issued
  cancelled
}

enum AlumniPostKind {
  announcement
  newsletter
}

enum AlumniPostStatus {
  draft
  published
  archived
}

enum AlumniEventStatus {
  draft
  published
  cancelled
}

enum AlumniRsvpResponse {
  going
  maybe
  declined
}

enum AlumniJobStatus {
  draft
  open
  closed
}

enum AlumniApplicationStatus {
  applied
  shortlisted
  interviewing
  offered
  rehired
  rejected
  withdrawn
}

enum AlumniRehireStatus {
  initiated
  completed
  cancelled
}

enum AlumniReferralStatus {
  submitted
  screening
  interviewing
  offered
  hired
  rejected
  withdrawn
}

enum AlumniRewardStatus {
  not_applicable
  pending
  approved
  paid
  cancelled
}

/// HR's record that an employee has left. When the exit is completed and F&F
/// is settled, the Alumni record is created from it.
model AlumniExitClosure {
  id              String    @id @default(cuid())
  tenantId        String
  /// Employee.id of the person who left (the Employee row is never changed).
  employeeId      String
  joiningDate     DateTime  @db.Date
  lastWorkingDay  DateTime  @db.Date
  personalEmail   String
  exitCompletedOn DateTime? @db.Date
  fnfSettledOn    DateTime? @db.Date
  fnfReference    String    @default("")
  notes           String    @default("")
  recordedById    String
  updatedById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  alumni          Alumni?

  @@unique([tenantId, employeeId])
  @@index([tenantId])
}

/// One former employee. Details are copied from the Employee master at exit.
model Alumni {
  id                     String                  @id @default(cuid())
  tenantId               String
  /// Employee.id of the employment this record came from.
  employeeId             String
  exitClosureId          String?                 @unique
  employeeCode           String
  fullName               String
  personalEmail          String
  designation            String                  @default("")
  departmentId           String?
  departmentName         String                  @default("")
  locationName           String                  @default("")
  joiningDate            DateTime                @db.Date
  lastWorkingDay         DateTime                @db.Date
  tenureMonths           Int
  eligibility            AlumniEligibility       @default(eligible)
  eligibilityReason      String                  @default("")
  eligibilityUpdatedById String?
  eligibilityUpdatedAt   DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  exitClosure            AlumniExitClosure?      @relation(fields: [exitClosureId], references: [id], onDelete: SetNull)
  account                AlumniAccount?
  profile                AlumniProfile?
  invitations            AlumniInvitation[]
  consents               AlumniConsent[]
  documents              AlumniDocument[]
  documentRequests       AlumniDocumentRequest[]
  rsvps                  AlumniEventRsvp[]
  applications           AlumniJobApplication[]
  rehires                AlumniRehire[]
  referrals              AlumniReferral[]

  @@unique([tenantId, employeeId])
  @@index([tenantId, eligibility])
  @@index([tenantId, personalEmail])
}

/// Alumni login, separate from User so alumni never hold an employee session.
model AlumniAccount {
  id                    String              @id @default(cuid())
  tenantId              String
  alumniId              String              @unique
  email                 String
  passwordHash          String
  status                AlumniAccountStatus @default(active)
  statusReason          String              @default("")
  emailVerifiedAt       DateTime
  failedLoginCount      Int                 @default(0)
  lockedUntil           DateTime?
  lastLoginAt           DateTime?
  /// Current state of the communications consent (history in AlumniConsent).
  communicationsConsent Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  alumni                Alumni              @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  sessions              AlumniSession[]
  otps                  AlumniOtp[]

  @@unique([tenantId, email])
  @@index([email])
}

/// Refresh token of an alumni login session.
model AlumniSession {
  id        String        @id @default(cuid())
  accountId String
  tokenHash String        @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime      @default(now())
  account   AlumniAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

/// One-time code for a password reset or a login email change.
model AlumniOtp {
  id                    String           @id @default(cuid())
  accountId             String
  purpose               AlumniOtpPurpose
  codeHash              String
  /// New email address for an email change.
  target                String           @default("")
  expiresAt             DateTime
  attemptCount          Int              @default(0)
  consumedAt            DateTime?
  resetSessionHash      String?          @unique
  resetSessionExpiresAt DateTime?
  createdAt             DateTime         @default(now())
  account               AlumniAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, purpose])
}

/// Registration link sent to the personal email. Only the SHA-256 of the token is stored.
model AlumniInvitation {
  id           String    @id @default(cuid())
  tenantId     String
  alumniId     String
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  sentById     String
  sentAt       DateTime  @default(now())
  acceptedAt   DateTime?
  revokedAt    DateTime?
  revokeReason String    @default("")
  alumni       Alumni    @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([alumniId])
}

/// Append-only consent log: every grant and withdrawal with time, IP and browser.
model AlumniConsent {
  id         String            @id @default(cuid())
  tenantId   String
  alumniId   String
  type       AlumniConsentType
  version    String
  granted    Boolean
  ipAddress  String            @default("")
  userAgent  String            @default("")
  recordedAt DateTime          @default(now())
  alumni     Alumni            @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([alumniId, type, recordedAt])
}

model AlumniProfile {
  id                 String    @id @default(cuid())
  alumniId           String    @unique
  currentEmployer    String    @default("")
  currentDesignation String    @default("")
  industry           String    @default("")
  location           String    @default("")
  phone              String    @default("")
  contactEmail       String    @default("")
  skills             String[]  @default([])
  photoPath          String    @default("")
  linkedinUrl        String    @default("")
  /// Field key -> true when other alumni in the directory may see it.
  visibility         Json      @default("{}")
  directoryOptIn     Boolean   @default(false)
  directoryOptInAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  alumni             Alumni    @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@index([directoryOptIn])
}

/// A file in the alumnus's own document vault.
model AlumniDocument {
  id               String                 @id @default(cuid())
  tenantId         String
  alumniId         String
  type             AlumniDocumentType
  title            String
  /// e.g. 2026-03 for a payslip or FY 2025-26 for Form 16.
  period           String                 @default("")
  fileName         String
  storagePath      String
  /// hr_upload | payslip_copy | request
  source           String                 @default("hr_upload")
  requestId        String?                @unique
  issuedById       String?
  issuedAt         DateTime               @default(now())
  revokedAt        DateTime?
  downloadCount    Int                    @default(0)
  lastDownloadedAt DateTime?
  alumni           Alumni                 @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  request          AlumniDocumentRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([tenantId, alumniId])
}

/// Request for a document or a duplicate copy: HR reviews, decides, then issues.
model AlumniDocumentRequest {
  id             String                      @id @default(cuid())
  tenantId       String
  alumniId       String
  type           AlumniDocumentType
  period         String                      @default("")
  reason         String
  status         AlumniDocumentRequestStatus @default(submitted)
  decisionNote   String                      @default("")
  reviewedById   String?
  decidedAt      DateTime?
  issuedAt       DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  alumni         Alumni                      @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  issuedDocument AlumniDocument?

  @@index([tenantId, status])
  @@index([alumniId])
}

model AlumniAnnouncement {
  id          String           @id @default(cuid())
  tenantId    String
  kind        AlumniPostKind   @default(announcement)
  title       String
  body        String
  /// Groups it is for: { departments, exitYears, joinYears, locations }; empty = everyone.
  audience    Json             @default("{}")
  status      AlumniPostStatus @default(draft)
  publishedAt DateTime?
  createdById String
  updatedById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([tenantId, status, publishedAt])
}

model AlumniEvent {
  id          String            @id @default(cuid())
  tenantId    String
  title       String
  description String            @default("")
  startsAt    DateTime
  endsAt      DateTime?
  venue       String            @default("")
  meetingUrl  String            @default("")
  capacity    Int?
  rsvpBy      DateTime?
  /// Same shape as AlumniAnnouncement.audience.
  audience    Json              @default("{}")
  status      AlumniEventStatus @default(draft)
  publishedAt DateTime?
  createdById String
  updatedById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  rsvps       AlumniEventRsvp[]

  @@index([tenantId, status, startsAt])
}

model AlumniEventRsvp {
  id          String             @id @default(cuid())
  eventId     String
  alumniId    String
  response    AlumniRsvpResponse
  note        String             @default("")
  respondedAt DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  event       AlumniEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  alumni      Alumni             @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  @@unique([eventId, alumniId])
  @@index([alumniId])
}

model AlumniJob {
  id             String                 @id @default(cuid())
  tenantId       String
  title          String
  departmentName String                 @default("")
  location       String                 @default("")
  employmentType String                 @default("Full-time")
  experience     String                 @default("")
  description    String
  status         AlumniJobStatus        @default(draft)
  openedAt       DateTime?
  closesOn       DateTime?              @db.Date
  createdById    String
  updatedById    String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  applications   AlumniJobApplication[]
  referrals      AlumniReferral[]

  @@index([tenantId, status])
}

model AlumniJobApplication {
  id        String                  @id @default(cuid())
  tenantId  String
  jobId     String
  alumniId  String
  note      String                  @default("")
  status    AlumniApplicationStatus @default(applied)
  /// Eligible alumni skip the first screening round.
  fastTrack Boolean                 @default(false)
  hrNote    String                  @default("")
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  job       AlumniJob               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  alumni    Alumni                  @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  rehire    AlumniRehire?

  @@unique([jobId, alumniId])
  @@index([tenantId, status])
}

/// Fast-track rehire. Completing it creates a NEW Employee through HrService;
/// the previous Employee row is never changed.
model AlumniRehire {
  id                 String                @id @default(cuid())
  tenantId           String
  alumniId           String
  applicationId      String?               @unique
  previousEmployeeId String
  newEmployeeId      String?               @unique
  status             AlumniRehireStatus    @default(initiated)
  designation        String
  departmentId       String?
  locationId         String?
  joiningDate        DateTime              @db.Date
  workEmail          String
  /// Copy of the previous employment as it was when the rehire started.
  previousEmployment Json
  notes              String                @default("")
  createdById        String
  completedById      String?
  completedAt        DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  alumni             Alumni                @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  application        AlumniJobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([alumniId])
}

model AlumniReferral {
  id              String               @id @default(cuid())
  tenantId        String
  alumniId        String
  jobId           String?
  candidateName   String
  candidateEmail  String
  candidatePhone  String               @default("")
  relationship    String               @default("")
  note            String               @default("")
  resumeFileName  String               @default("")
  resumePath      String               @default("")
  status          AlumniReferralStatus @default(submitted)
  hrNote          String               @default("")
  rewardAmount    Decimal?             @db.Decimal(12, 2)
  rewardCurrency  String               @default("INR")
  rewardStatus    AlumniRewardStatus   @default(not_applicable)
  rewardPaidOn    DateTime?            @db.Date
  rewardReference String               @default("")
  updatedById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  alumni          Alumni               @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  job             AlumniJob?           @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([alumniId])
}

/// Status trail for document requests, job applications, referrals and rehires.
model AlumniStatusHistory {
  id         String   @id @default(cuid())
  tenantId   String
  /// document_request | job_application | referral | rehire
  entityType String
  entityId   String
  fromStatus String   @default("")
  toStatus   String
  note       String   @default("")
  /// hr | alumni | system
  actorType  String
  actorId    String   @default("")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}
